MODE=distributed
NOEMA_POSTGRES_DSN=postgresql://noema:noema-dev@127.0.0.1:55432/noema
NOEMA_NATS_SERVERS=nats://127.0.0.1:4222
NOEMA_RUNTIME_ID=local-runtime

# Optional OTLP exporter. Leave unset for the dependency-free no-op tracer.
# NOEMA_OTLP_ENDPOINT=http://127.0.0.1:4317
# NOEMA_OTLP_INSECURE=true

# Optional typed decisions (explicit live smoke opt-in; may incur charges)
NOEMA_DECISIONS_LIVE=0
